# ==============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para `.env` e preencha com seus dados reais:
#   cp .env.example .env
# ==============================================================================

# API do Resend (https://resend.com)
# Obtenha em: Resend Dashboard > API Keys
RESEND_API_KEY=re_sua_chave_aqui

# Para onde as mensagens enviadas no formulário devem chegar
CONTACT_TO_EMAIL=seu-email@exemplo.com

# Remetente autenticado. Precisa pertencer a um domínio verificado no Resend.
# Durante testes locais sem domínio próprio, você pode usar: onboarding@resend.dev
CONTACT_FROM_EMAIL=contato@seudominio.com.br

# Cloudflare Turnstile - Captcha gratuito anti-spam (https://dash.cloudflare.com)
# Obtenha em: Cloudflare Dashboard > Turnstile > Add Site
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=sua_site_key_aqui
CLOUDFLARE_TURNSTILE_SECRET_KEY=sua_secret_key_aqui